PLATFORM_SOURCE_DIR=/absolute/path/to/jagalchi-platform
API_SOURCE_DIR=/absolute/path/to/jagalchi-api
AI_SOURCE_DIR=/absolute/path/to/jagalchi-ai

API_POSTGRES_PASSWORD=local-api-password-at-least-16-characters
AI_POSTGRES_PASSWORD=local-ai-password-at-least-16-characters
JWT_ACCESS_SECRET=local-access-secret-at-least-32-characters
AI_AUTH_JWT_SECRET=local-ai-auth-secret-at-least-32-characters
VERIFICATION_CODE_SECRET=local-verification-secret-at-least-32-characters
RATE_LIMIT_HASH_SECRET=local-rate-limit-secret-at-least-32-characters
DJANGO_SECRET_KEY=local-django-secret-at-least-32-characters
OBJECT_STORAGE_ACCESS_KEY_ID=jagalchi-local
OBJECT_STORAGE_SECRET_ACCESS_KEY=local-object-storage-secret-at-least-16-characters
OBJECT_STORAGE_BUCKET=jagalchi-local
LOCAL_SEED_EMAIL=operator@jagalchi.local
LOCAL_SEED_PASSWORD=local-operator-password-at-least-16-characters

JAGALCHI_LOCAL_MODE=local
JOB_SOURCE_PROVIDER=fixture
GITHUB_PROVIDER=fixture
AI_PROVIDER=deepseek
AI_V1_PROVIDER=deepseek
WORKFLOW_LEASE_MS=120000
WORKFLOW_HEARTBEAT_MS=5000
WORKFLOW_HEALTH_MAX_AGE_MS=15000
WORKFLOW_POLL_MS=1000
AI_DISABLE_EXTERNAL=false
AI_DISABLE_LLM=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_EXTRACTION_MODEL=deepseek-v4-flash
DEEPSEEK_PLANNING_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
OBJECT_STORAGE_PRESIGN_ENDPOINT=http://127.0.0.1:9000
# Required only for ci-real-source/local-real-source/local-real acceptance:
REAL_JOB_SOURCE_URL=
